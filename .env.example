PORT=3000

# فقط یکی از این کلیدها کافی است؛ هر سه نسخه (Lite / MIOS / Astara) از همان یک کلید استفاده می‌کنند.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# مدل هر سرویس (اختیاری)
OPENROUTER_MODEL=openrouter/free
OPENAI_MODEL=gpt-5.6
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_MODEL=deepseek-chat
XAI_MODEL=grok-4
GEMINI_MODEL=gemini-2.5-flash

# درصد قدرت هر نسخه (۱۰ تا ۱۰۰)
LITE_POWER=50
MIOS_POWER=80
ASTARA_POWER=100

# جستجوی وب: بدون کلید هم کار می‌کند (DuckDuckGo + ویکی‌پدیا).
# برای کیفیت بهتر می‌توانید کلید رایگان tavily.com را بگذارید (اختیاری).
TAVILY_API_KEY=
